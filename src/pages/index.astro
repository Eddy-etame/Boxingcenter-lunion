---
/**
 * L'ACCUEIL — dans l'ordre des questions d'un Unionais.
 *
 * Le fait de ce site, qu'aucun autre du réseau ne possède : la place. 1 200 m²
 * en trois espaces, une seule adresse, au bout du périphérique qui borde
 * L'Union. La page le prouve dans l'ordre où on le demande : la salle et son
 * plan sous son titre (02), ce qui s'y pratique et dans quel espace (03), le
 * moteur (04), le trajet (05), le premier jour (06), le cas par cas (07), les
 * communes voisines (08), décider (09).
 *
 * Aucun titre de section n'existe sur un autre site de la famille. Chaque
 * nombre se compte depuis le registre. Aucune heure de cours n'est écrite :
 * les plannings du club la donnent.
 */
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import PlanDeLaSalle from '../components/PlanDeLaSalle.astro';
import Seance from '../components/Seance.astro';
import Photo from '../components/Photo.astro';
import { SITE, DESTINATION, VILLE, LIMITROPHES, CONTACT, NOTE_SECTEUR } from '../data/verite';
import { COMMUNES } from '../data/communes';
import { OFFRES, offresDe, offresDeLaPage, type PageDiscipline } from '../data/offres';
import { ROLES } from '../data/medias';
import { route } from '../data/routes';
import { ITINERAIRES, MEILLEUR, DEPARTS, ARRIVEE, AVERTISSEMENT, enLettres } from '../data/transports';

const fait = (cle: string) => DESTINATION.faits.find((f) => f.cle === cle)?.valeur ?? '';
const nombre = (texte: string, motif: RegExp) => Number(motif.exec(texte)?.[1] ?? 0);
const majuscule = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const minuscule = (s: string) => s.charAt(0).toLowerCase() + s.slice(1);
const enumerer = (mots: string[]) =>
  mots.length > 1 ? `${mots.slice(0, -1).join(', ')} et ${mots[mots.length - 1]}` : mots[0] ?? '';

const NB_ESPACES = nombre(fait('Espaces'), /^(\d+) /);
const NB_RINGS = nombre(fait('Équipement'), /(\d+) rings?/);
const NB_SACS = nombre(fait('Équipement'), /(\d+) sacs?/);
const AIRE = /(\d[\d ]*m²)/.exec(fait('Espaces'))?.[1] ?? '';
const COMBIEN_INTITULES = enLettres(OFFRES.length);

/** Les pages de discipline, dans l'ordre où on les cherche, avec l'espace de la salle qui les porte. */
const PORTES: readonly { id: PageDiscipline; nom: string; espace: string }[] = [
  { id: 'mma', nom: 'MMA et grappling', espace: 'salle MMA' },
  { id: 'boxe-anglaise', nom: 'Boxe anglaise', espace: 'salle Boxe' },
  { id: 'kick-boxing', nom: 'Pieds-poings, Muay Thai et full contact', espace: 'salle Boxe' },
  { id: 'boxe-enfants', nom: 'Enfants et ados', espace: 'salle Boxe et salle MMA' },
  { id: 'preparation-physique', nom: 'Préparation physique et Lady Punch', espace: 'espace préparation physique' },
];
const MMA = offresDe('mma')[0];
const GRAPPLING = offresDe('grappling');
const ENFANTS = offresDe('enfants');
const [SAINT_JEAN, ROUFFIAC] = COMMUNES;
const depart = (commune: string) => DEPARTS.find((d) => d.depuis === commune)?.texte ?? '';
const dernier = (it: (typeof ITINERAIRES)[number]) => it.etapes[it.etapes.length - 1];
const [BUS, METRO, FIN] = MEILLEUR.etapes;

/**
 * Le cas par cas. Chaque réponse s'ouvre sur un fait ; les nombres et les
 * intitulés viennent du registre.
 */
const QUESTIONS = [
  {
    titre: `Où est le club de boxe le plus proche de ${SITE.ville} ?`,
    texte: `Au ${DESTINATION.adresse}, à côté de la sortie 33b « Lalande » du périphérique. C’est la plus grande salle du réseau : ${fait('Surface')} en ${fait('Espaces')}.`,
  },
  {
    titre: 'Qu’est-ce qu’on peut y pratiquer ?',
    texte: `Un club de sport de combat complet, proche de ${SITE.ville}. ${majuscule(COMBIEN_INTITULES)} intitulés publiés par le club : ${enumerer(OFFRES.map((o) => o.intitule))}.`,
  },
  {
    titre: 'Je n’ai jamais fait de sport de combat. Je peux venir ?',
    texte: 'Oui, c’est le cas de la plupart des gens qui s’inscrivent. Aucun test à l’entrée, aucun niveau demandé. Une première séance, c’est de l’échauffement, un geste travaillé lentement, du sac et des pattes d’ours. Tu frappes, personne ne te frappe.',
  },
  {
    titre: 'Il y a une vraie cage pour le MMA ?',
    texte: `Oui, une cage surélevée officielle, dans la salle MMA : ${AIRE} de tatamis, des protections murales, et des panneaux de séparation pour travailler le cage control. « ${MMA?.intitule} » s’entraîne dedans, avec ${enumerer(GRAPPLING.map((o) => `« ${o.intitule} »`))} à côté.`,
  },
  {
    titre: 'Et si je viens pour la muscu ou le cardio ?',
    texte: `L’espace préparation physique fait ${AIRE} : ${enLettres(NB_SACS)} sacs de frappe, musculation, cardio, cross-training, une cage de street workout, en accès libre ${DESTINATION.horaires.valeur.split(';')[0].replace(/^en accès libre /, '')}.`,
  },
  {
    titre: 'Comment y aller sans voiture ?',
    texte: `${depart(SITE.ville)} ${ARRIVEE.phrase}`,
  },
  {
    titre: 'Mon enfant peut s’inscrire ?',
    texte: `Oui. ${enumerer(ENFANTS.map((o) => `« ${o.intitule} »${o.ages ? ` (${o.ages})` : ''}`))}. ${ENFANTS[0]?.detail ?? ''}`,
  },
  {
    titre: `J’habite ${SAINT_JEAN.nom} ou ${ROUFFIAC.nom}.`,
    texte: `Chaque commune a sa page ici. ${depart(SAINT_JEAN.nom)} Depuis ${ROUFFIAC.nom}, ${minuscule(ROUFFIAC.cotes[1].valeur.split(' · ')[0])} mène au périphérique et à la sortie 33b.`,
  },
];
---

<Base page="accueil" faq={QUESTIONS}>
  <Hero />

  {/* ─────────── 02 — LA SALLE ─────────── */}
  <section class="section salle" id="salle" aria-labelledby="t-salle">
    <div class="enveloppe">
      <p class="cartouche"><span class="cartouche__num">02</span><span>La salle</span></p>
      <div class="salle__tete">
        <h2 id="t-salle">
          {majuscule(enLettres(NB_ESPACES))} espaces de {AIRE},<br />
          <span class="salle__accent">et personne qui attend son tour.</span>
        </h2>
        <p class="lead faible">
          Pour un club de boxe proche de {SITE.ville}, l’adresse est le
          {' '}<strong>{DESTINATION.adresse}</strong>. {NOTE_SECTEUR}
        </p>
      </div>

      <PlanDeLaSalle />

      <div class="salle__bas">
        <p class="salle__texte">
          C’est ce que change la place&nbsp;: un cours de boxe tourne sur {enLettres(NB_RINGS)} rings
          pendant qu’un autre travaille au sol dans la cage et qu’un troisième enchaîne aux
          {' '}{enLettres(NB_SACS)} sacs. Tu ne partages pas le même mètre carré avec tout le monde.
        </p>
        <dl class="salle__faits">
          <div><dt class="mono">Accueil</dt><dd>{DESTINATION.horairesCourt}</dd></div>
          <div><dt class="mono">Téléphone</dt><dd><a class="lien" href={`tel:${DESTINATION.telephoneLien}`}>{DESTINATION.telephone}</a></dd></div>
        </dl>
        <div class="salle__actions">
          <a class="bouton bouton--signal" href={DESTINATION.site} rel="noopener">
            <span>Ouvrir le site du club</span><span class="fleche" aria-hidden="true">↗</span>
          </a>
          <a class="bouton" href={DESTINATION.activites} rel="noopener">
            <span>Les activités, décrites par le club</span><span class="fleche" aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* ─────────── 03 — LES COURS, PAR ESPACE ─────────── */}
  <section class="section encre cours" id="cours" aria-labelledby="t-cours">
    <div class="enveloppe">
      <p class="cartouche"><span class="cartouche__num">03</span><span>Ce qui se pratique</span></p>
      <div class="cours__tete">
        <h2 id="t-cours">
          Le MMA dans la cage, la boxe sur {enLettres(NB_RINGS)} rings,<br />
          <span class="cours__accent">le reste aux {enLettres(NB_SACS)} sacs.</span>
        </h2>
        <p class="lead faible cours__intro">
          Un club et une salle de MMA près de {SITE.ville}&nbsp;: «&nbsp;{MMA?.intitule}&nbsp;»,
          {' '}{enumerer(GRAPPLING.map((o) => `« ${o.intitule} »`))} sur {AIRE} de tatamis. La salle
          Boxe publie {enumerer(offresDeLaPage('boxe-anglaise').concat(offresDeLaPage('kick-boxing')).map((o) => `« ${o.intitule} »`))}.
          {' '}{majuscule(COMBIEN_INTITULES)} intitulés, mot pour mot, rangés par page.
        </p>
      </div>

      <ol class="cours__liste">
        {PORTES.map((p, i) => {
          const offres = offresDeLaPage(p.id);
          return (
            <li class="reveler" style={`--retard:${i * 60}ms`}>
              <a class="cours__page" href={route(p.id).chemin}>
                <span class="mono cours__num">{String(i + 1).padStart(2, '0')}</span>
                <span class="cours__corps">
                  <span class="cours__nom">{p.nom}</span>
                  <span class="cours__intitules">{offres.map((o) => o.intitule).join(' · ')}</span>
                  <span class="mono cours__espace">{p.espace}</span>
                </span>
                <span class="fleche" aria-hidden="true">→</span>
              </a>
            </li>
          );
        })}
      </ol>
    </div>
  </section>

  {/* ─────────── 04 — LE MOTEUR ─────────── */}
  <Seance titre={'Choisis ton cours et ton moment.\nLa salle a la place pour les deux.'} numero="04" />

  {/* ─────────── 05 — Y ALLER ─────────── */}
  <section class="section trajet" id="trajet" aria-labelledby="t-trajet">
    <div class="enveloppe trajet__inner">
      <div class="trajet__texte">
        <p class="cartouche"><span class="cartouche__num">05</span><span>Y aller</span></p>
        <h2 id="t-trajet">
          La {BUS.code} jusqu’au métro, le {METRO.code} jusqu’à {METRO.a},<br />
          <span class="trajet__accent">et {FIN.precision}.</span>
        </h2>
        <p class="lead faible">
          Les cours de boxe accessibles depuis {SITE.ville} en transports en commun&nbsp;:
          {' '}{MEILLEUR.resume} {ARRIVEE.phrase}
        </p>
        <p class="trajet__voiture mono">En voiture&nbsp;: {minuscule(DESTINATION.acces.split('.')[0])}.</p>
        <div class="trajet__actions">
          <a class="bouton bouton--signal" href={route('transports').chemin}>
            <span>Le trajet, arrêt par arrêt</span><span class="fleche" aria-hidden="true">→</span>
          </a>
          <a class="bouton" href={DESTINATION.plannings} rel="noopener">
            <span>Les plannings, pour caler ton bus</span><span class="fleche" aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      <div class="trajet__cote">
        <ol class="trajet__lignes">
          {ITINERAIRES.map((it, i) => (
            <li class="reveler" style={`--retard:${i * 80}ms`}>
              <a href={`${route('transports').chemin}?trajet=${it.id}`}>
                <span class={`trajet__code trajet__code--${it.etapes[0].mode}`}>{it.etapes[0].code}</span>
                <span class="trajet__parcours">{it.onglet}</span>
                <span class="mono trajet__jours">
                  {it.etapes.length === 1 ? 'direct' : `${enLettres(it.etapes.length)} étapes`} · {dernier(it).a}
                </span>
              </a>
            </li>
          ))}
        </ol>
        <p class="trajet__avertissement">{AVERTISSEMENT}</p>
      </div>
    </div>
  </section>

  {/* ─────────── 06 — LE PREMIER JOUR ─────────── */}
  <section class="section creuse premiere" id="premiere" aria-labelledby="t-premiere">
    <div class="enveloppe premiere__inner">
      <div class="premiere__image">
        <Photo slug={ROLES.premiereSeance} sizes="(max-width: 62rem) 100vw, 40vw" ratio="3 / 4" legende />
      </div>
      <div class="premiere__texte">
        <p class="cartouche"><span class="cartouche__num">06</span><span>La première fois</span></p>
        <h2 id="t-premiere">
          Ton premier jour&nbsp;: une tenue, de l’eau,<br />
          <span class="premiere__accent">et le sac de frappe, dans {fait('Surface')}.</span>
        </h2>
        <p class="lead faible premiere__intro">
          Pour les sports de combat à proximité de {SITE.ville}, la première séance se déroule
          de la même façon, quel que soit l’espace, et la plupart des inscrits ont commencé par elle.
        </p>
        <ol class="premiere__etapes">
          <li>
            <span class="mono">01</span>
            <p><strong>Tu apportes une tenue de sport et de l’eau.</strong> Pour les gants et les bandes, tu demandes au club en arrivant.</p>
          </li>
          <li>
            <span class="mono">02</span>
            <p><strong>Tu frappes.</strong> De la corde, un geste décomposé lentement par le coach, du sac, puis les pattes d’ours.</p>
          </li>
          <li>
            <span class="mono">03</span>
            <p><strong>Chacun est occupé à sa propre séance.</strong> Le coach te suit, le reste de la salle a la tête dans son travail — et la place ne manque à personne.</p>
          </li>
          <li>
            <span class="mono">04</span>
            <p><strong>Tu repars essoufflé, et content d’être venu.</strong> C’est le seul objectif d’une première séance.</p>
          </li>
        </ol>
        <div class="premiere__actions">
          <a class="bouton bouton--signal" href={DESTINATION.tarifs} rel="noopener">
            <span>Réserver ma première séance</span><span class="fleche" aria-hidden="true">↗</span>
          </a>
          <a class="lien premiere__lien" href={route('premiere-seance').chemin}>
            Le déroulé complet, minute par minute →
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* ─────────── 07 — CAS PAR CAS ─────────── */}
  <section class="section questions" id="questions" aria-labelledby="t-questions">
    <div class="enveloppe questions__inner">
      <div class="questions__tete">
        <p class="cartouche"><span class="cartouche__num">07</span><span>Cas par cas</span></p>
        <h2 id="t-questions">
          Enfant, débutant, cage, bus&nbsp;:<br />
          <span class="questions__accent">le fait qui répond à chaque question.</span>
        </h2>
        <p class="lead faible">
          {majuscule(enLettres(QUESTIONS.length))} réponses courtes, chacune ouverte sur ce qui est vrai.
          Si la tienne manque, appelle le club au
          {' '}<a class="lien" href={`tel:${CONTACT.telephoneLien.valeur}`}>{CONTACT.telephone.valeur}</a>,
          ou <a class="lien" href={route('contact').chemin}>écris-nous en deux lignes →</a>
        </p>
      </div>
      <div class="questions__liste">
        {QUESTIONS.map((q, i) => (
          <details class="qr" open={i === 0}>
            <summary>
              <span class="qr__q">{q.titre}</span>
              <span class="qr__signe" aria-hidden="true"></span>
            </summary>
            <p class="qr__r">{q.texte}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  {/* ─────────── 08 — LE SECTEUR ─────────── */}
  <section class="section creuse secteur" id="secteur" aria-labelledby="t-secteur">
    <div class="enveloppe">
      <p class="cartouche"><span class="cartouche__num">08</span><span>Le secteur</span></p>
      <div class="secteur__tete">
        <h2 id="t-secteur">
          Depuis {SAINT_JEAN.nom}, la {SAINT_JEAN.cotes[0].valeur.split(',')[0]} jusqu’au métro.<br />
          <span class="secteur__accent">Depuis {ROUFFIAC.nom}, par la {minuscule(ROUFFIAC.cotes[1].valeur.split(' · ')[0])}.</span>
        </h2>
        <p class="lead faible secteur__intro">
          {SITE.ville}, {VILLE.statut.valeur}, touche {enumerer(LIMITROPHES.map((l) => l.nom))}.
          {' '}{majuscule(VILLE.histoire.valeur)}, et elle borde le périphérique&nbsp;: la même rocade
          mène à la sortie 33b, où se trouve le club.
        </p>
      </div>

      <ul class="secteur__pages">
        {COMMUNES.map((c, i) => (
          <li class="reveler" style={`--retard:${i * 90}ms`}>
            <a class="carte" href={`/${c.id}/`}>
              <span class="mono carte__cp">{c.codePostal}</span>
              <span class="carte__nom">{c.nom}</span>
              <span class="carte__trajet">
                <span class="mono carte__ligne">{c.cotes[0].valeur}</span>
                <span aria-hidden="true">→</span>
                <span class="carte__club">{DESTINATION.nomCourt}</span>
              </span>
              <span class="mono carte__aller">Le trajet depuis {c.nom} <span aria-hidden="true">→</span></span>
            </a>
          </li>
        ))}
      </ul>

      <p class="mono secteur__cle">Les {enLettres(LIMITROPHES.length)} communes limitrophes de {SITE.ville}</p>
      <ul class="secteur__liste">
        {LIMITROPHES.map((c) => (
          <li class={c.note ? 'secteur__item secteur__item--cle' : 'secteur__item'}>
            <span class="secteur__nom">{c.nom}</span>
            {c.note && <span class="secteur__note">{c.note}</span>}
          </li>
        ))}
      </ul>
      <p class="secteur__pied">
        Boxing Center accueille les habitants de {SITE.ville} et du {SITE.secteur}
        {' '}dans son club de {DESTINATION.nomCourt}. Accès par {VILLE.routes.valeur}&nbsp;;
        en transports, {VILLE.bus.valeur}.
      </p>
    </div>
  </section>

  {/* ─────────── 09 — DÉCIDER ─────────── */}
  <section class="section encre convergence" id="decider" aria-labelledby="t-convergence">
    <div class="enveloppe convergence__inner">
      <p class="cartouche"><span class="cartouche__num">09</span><span>Décider</span></p>
      <h2 id="t-convergence">
        Une adresse, {enLettres(NB_ESPACES)} espaces,<br />
        <span class="convergence__accent">et ta séance d’essai à réserver.</span>
      </h2>
      <p class="lead convergence__texte">
        La séance d’essai se réserve sur le site du club. Si tu préfères demander d’abord,
        appelle le club, ou écris-nous en deux lignes&nbsp;: on te répond avec un créneau.
      </p>
      <div class="convergence__actions">
        <a class="bouton bouton--signal" href={DESTINATION.tarifs} rel="noopener">
          <span>Réserver sur le site du club</span><span class="fleche" aria-hidden="true">↗</span>
        </a>
        <a class="bouton" href={`tel:${CONTACT.telephoneLien.valeur}`}>
          <span>{CONTACT.telephone.valeur}</span><span class="fleche" aria-hidden="true">↗</span>
        </a>
        <a class="bouton" href={route('contact').chemin}>
          <span>Le formulaire de contact</span><span class="fleche" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ── 02 La salle ───────────────────────────────────────────────────── */
  .salle__tete {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: var(--e-5) var(--e-8);
    align-items: end;
    margin-bottom: var(--e-7);
  }
  @media (max-width: 56rem) { .salle__tete { grid-template-columns: 1fr; gap: var(--e-4); margin-bottom: var(--e-5); } }
  .salle h2 { max-width: 20ch; }
  .salle__accent { color: var(--signal-texte); }
  .salle__tete .lead { max-width: 48ch; }
  .salle__tete .lead strong { color: var(--encre); font-weight: 600; }
  .salle__bas {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: var(--e-6) var(--e-8);
    align-items: start;
    margin-top: var(--e-7);
  }
  @media (max-width: 56rem) { .salle__bas { grid-template-columns: 1fr; } }
  .salle__texte { max-width: 56ch; color: var(--texte-faible); }
  .salle__faits { display: grid; gap: 0; margin: 0; }
  .salle__faits > div { display: grid; gap: 0.15rem; padding: var(--e-3) 0; border-top: 1px solid var(--trait); }
  .salle__faits > div:last-child { border-bottom: 1px solid var(--trait); }
  .salle__faits dt { color: var(--graphite); }
  .salle__faits dd { margin: 0; font-size: var(--t-petit); font-weight: 600; }
  .salle__actions { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: var(--e-3); }

  /* ── 03 Les cours, par espace ──────────────────────────────────────── */
  .cours__tete {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--e-5) var(--e-8);
    align-items: end;
    margin-bottom: var(--e-7);
  }
  @media (max-width: 56rem) { .cours__tete { grid-template-columns: 1fr; } }
  .cours h2 { max-width: 20ch; }
  .cours__accent { color: var(--signal-texte); }
  .cours__intro { max-width: 50ch; }
  .cours__liste { list-style: none; display: grid; }
  .cours__page {
    display: grid;
    grid-template-columns: 3rem 1fr auto;
    gap: var(--e-4);
    align-items: center;
    padding: var(--e-4) 0;
    border-top: 1px solid var(--trait);
    text-decoration: none;
    color: inherit;
    transition: padding-left var(--d-normal) var(--e-sortie);
  }
  .cours__liste li:last-child .cours__page { border-bottom: 1px solid var(--trait); }
  .cours__page:hover { padding-left: var(--e-3); }
  .cours__page:hover .cours__nom { color: var(--signal-texte); }
  .cours__num { color: var(--signal-texte); font-weight: 700; }
  .cours__corps { display: grid; gap: 0.2rem; }
  .cours__nom { font-family: var(--police-titre); font-size: var(--t-h3); font-weight: 700; letter-spacing: -0.015em; transition: color var(--d-rapide) var(--e-mecanique); }
  .cours__intitules { font-size: var(--t-petit); color: var(--texte-faible); }
  .cours__espace { color: var(--graphite); text-transform: none; letter-spacing: 0.05em; }
