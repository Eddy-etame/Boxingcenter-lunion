---
/**
 * LE HERO — un écran, et la porte du club dedans.
 *
 * Ce qu'il fait, dans l'ordre où un Unionais se pose les questions :
 * confirmer qu'il est au bon endroit (le H1), lui donner la raison de rester
 * (les disciplines), nommer le club, dire en une phrase ce qu'il a que
 * personne d'autre n'a — la place —, et ouvrir la porte du club avant le
 * premier défilement.
 *
 * Le plan de la salle vit une section plus bas, sous le titre qu'il
 * illustre : ici, il coûtait presque un écran avant le premier mot sur le
 * club. Le second bouton y mène par une ancre.
 *
 * Le H1 est fixé par le cahier des charges : « proche de ».
 */
import { SITE, DESTINATION } from '../data/verite';
import { offresDe, type Famille } from '../data/offres';
import { enLettres } from '../data/transports';

/** Les familles publiées, nommées comme dans les pages, dans l'ordre où on les cherche. */
const FAMILLES: readonly { id: Famille; nom: string }[] = [
  { id: 'boxe-anglaise', nom: 'boxe anglaise' },
  { id: 'kick-boxing', nom: 'pieds-poings' },
  { id: 'thai', nom: 'Muay Thai' },
  { id: 'mma', nom: 'MMA' },
  { id: 'grappling', nom: 'grappling' },
  { id: 'enfants', nom: 'cours enfants' },
];
const enumerer = (mots: string[]) =>
  mots.length > 1 ? `${mots.slice(0, -1).join(', ')} et ${mots[mots.length - 1]}` : mots[0] ?? '';
const majuscule = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const DISCIPLINES = enumerer(FAMILLES.filter((f) => offresDe(f.id).length).map((f) => f.nom));

/** Les cotes du club, projetées telles quelles depuis le registre. */
const fait = (cle: string) => DESTINATION.faits.find((f) => f.cle === cle)?.valeur ?? '';
const nombre = (texte: string, motif: RegExp) => Number(motif.exec(texte)?.[1] ?? 0);
const NB_ESPACES = nombre(fait('Espaces'), /^(\d+) /);
const NB_RINGS = nombre(fait('Équipement'), /(\d+) rings?/);
const NB_SACS = nombre(fait('Équipement'), /(\d+) sacs?/);
const AIRE = /(\d[\d ]*m²)/.exec(fait('Espaces'))?.[1] ?? '';
const COTES = [DESTINATION.adresse.split(',')[0], fait('Surface'), fait('Espaces'), DESTINATION.horairesCourt];
---

<section class="hero" aria-labelledby="t-hero">
  <div class="enveloppe">
    <p class="hero__cartouche mono">
      <span class="hero__planche">Boxing Center</span>
      <span aria-hidden="true">·</span>
      <span>à proximité de {SITE.ville}</span>
    </p>

    <div class="hero__texte">
      <h1 id="t-hero" class="hero__titre">
        <span class="hero__ligne">La plus grande salle</span>
        <span class="hero__ligne">de sports de combat,</span>
        <span class="hero__ligne hero__ligne--accent">proche de {SITE.ville}.</span>
      </h1>

      <p class="hero__promesse">
        <strong>{majuscule(DISCIPLINES)}, à {DESTINATION.nom}.</strong>
        {fait('Surface')} en {enLettres(NB_ESPACES)} espaces&nbsp;: {enLettres(NB_RINGS)} rings de
        compétition, une cage surélevée sur {AIRE} de tatamis, et {enLettres(NB_SACS)} sacs de frappe.
      </p>

      <p class="hero__cotes mono">
        {COTES.map((c, i) => (
          <>
            {i > 0 && <span aria-hidden="true">·</span>}
            <span>{c}</span>
          </>
        ))}
      </p>

      <div class="hero__actions">
        <a class="bouton bouton--signal" href={DESTINATION.tarifs} rel="noopener">
          <span>Réserver ma séance d’essai</span>
          <span class="fleche" aria-hidden="true">↗</span>
        </a>
        <a class="bouton" href="#salle">
          <span>Le plan de la salle</span>
          <span class="fleche" aria-hidden="true">↓</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(2rem, 1rem + 4vw, 4.5rem) clamp(2.5rem, 1.5rem + 4vw, 5rem);
    background: var(--papier);
    overflow: hidden;
  }

  /* Le papier a un grain de calque : des lignes de trame très pâles. */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(to right, var(--trait-faible) 1px, transparent 1px),
      linear-gradient(to bottom, var(--trait-faible) 1px, transparent 1px);
    background-size: 3.5rem 3.5rem;
    mask-image: radial-gradient(120% 90% at 45% 45%, #000 0%, transparent 78%);
    opacity: 0.55;
  }
  .hero > * { position: relative; }

  .hero__cartouche {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-3);
    align-items: center;
    padding-bottom: var(--e-4);
    border-bottom: 1px solid var(--trait);
    margin-bottom: var(--e-7);
  }
  .hero__planche { color: var(--signal-texte); font-weight: 700; }

  .hero__texte { max-width: 60rem; }

  .hero__titre { max-width: 15ch; margin-bottom: var(--e-5); }
  /* La signature du site : les lignes arrivent de la droite, comme on entre
     dans la salle par l'avenue — le même geste que les trois espaces du plan. */
  .hero__ligne {
    display: block;
    animation: poser 760ms var(--e-sortie) both;
    animation-delay: calc(var(--i, 0) * 100ms);
  }
  .hero__ligne:nth-child(1) { --i: 0; }
  .hero__ligne:nth-child(2) { --i: 1; }
  .hero__ligne:nth-child(3) { --i: 2; }
  .hero__ligne--accent { color: var(--signal-texte); }
  @keyframes poser {
    from { opacity: 0; transform: translateX(0.5em); }
    to { opacity: 1; transform: none; }
  }

  .hero__promesse {
    max-width: 54ch;
    font-size: var(--t-lead);
    line-height: 1.45;
    color: var(--texte-faible);
    padding-left: var(--e-5);
    border-left: 2px solid var(--signal);
    animation: poser 760ms var(--e-sortie) 300ms both;
  }
  .hero__promesse strong { color: var(--encre); font-weight: 600; }

  .hero__cotes {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-2) var(--e-3);
    margin-top: var(--e-5);
    padding-left: calc(var(--e-5) + 2px);
    color: var(--graphite);
    text-transform: none;
    letter-spacing: 0.05em;
    animation: poser 760ms var(--e-sortie) 420ms both;
  }
  .hero__cotes span:first-child { color: var(--encre); font-weight: 700; }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-3);
    margin-top: var(--e-6);
    animation: poser 760ms var(--e-sortie) 540ms both;
  }

  /* Sur téléphone, le héros tient dans l'écran : la section 02 commence juste après. */
  @media (max-width: 48rem) {
    .hero { padding-block: 1.75rem 2rem; }
    .hero__cartouche { margin-bottom: var(--e-6); }
  }

  :global(.no-js) .hero__ligne,
  :global(.no-js) .hero__promesse,
  :global(.no-js) .hero__cotes,
  :global(.no-js) .hero__actions { animation: none; opacity: 1; transform: none; }

  @media (prefers-reduced-motion: reduce) {
    .hero__ligne,
    .hero__promesse,
    .hero__cotes,
    .hero__actions { animation: none !important; opacity: 1; transform: none; }
  }
</style>
