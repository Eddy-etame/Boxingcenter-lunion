---
/**
 * LE HERO — « le plan de la salle ».
 *
 * Ce club a un fait que personne d'autre n'a dans le réseau : 1 200 m² en
 * trois espaces de 400 m². Le dessin est donc le plan de la salle — trois
 * carrés côte à côte, avec ce qu'il y a dedans : la cage et les tatamis, les
 * deux rings, les seize sacs.
 *
 * En bas, l'avenue des États-Unis et l'entrée au 388, avec l'arrêt de la 59.
 *
 * Tout est en SVG inline — aucun canvas, aucune bibliothèque, aucune requête.
 * Sans JavaScript et en mouvement réduit, le plan est déjà à son état final.
 * Deux tracés existent, horizontal et vertical.
 */
import { SITE, DESTINATION } from '../data/verite';
import { route } from '../data/routes';

const sacs = Array.from({ length: 16 }, (_, i) => i);
---

<section class="hero" aria-labelledby="t-hero">
  <div class="enveloppe">
    <p class="hero__cartouche mono">
      <span class="hero__planche">Boxing Center</span>
      <span aria-hidden="true">·</span>
      <span>à proximité de {SITE.ville}</span>
    </p>

    <div class="hero__haut">
      <div class="hero__texte">
        <h1 id="t-hero" class="hero__titre">
          <span class="hero__ligne">La plus grande salle</span>
          <span class="hero__ligne">de sports de combat,</span>
          <span class="hero__ligne hero__ligne--accent">proche de {SITE.ville}.</span>
        </h1>

        <p class="hero__promesse">
          <strong>Boxe anglaise, pieds-poings, full contact, travail au sol et cours enfants.</strong>
          1 200 m² en trois espaces&nbsp;: deux rings de compétition, une cage
          surélevée sur 400 m² de tatamis, et seize sacs de frappe. Tu peux venir
          sans avoir jamais boxé.
        </p>

        <div class="hero__actions">
          <a class="bouton bouton--signal" href={DESTINATION.tarifs} rel="noopener">
            <span>Réserver ma séance d’essai</span>
            <span class="fleche" aria-hidden="true">↗</span>
          </a>
          <a class="bouton" href={route('ta-seance').chemin}>
            <span>Trouver ma séance</span>
            <span class="fleche" aria-hidden="true">→</span>
          </a>
          <a class="bouton" href={route('transports').chemin}>
            <span>Y aller sans voiture</span>
            <span class="fleche" aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      <dl class="hero__faits">
        <div>
          <dt class="mono">Le club</dt>
          <dd>{DESTINATION.nomCourt}</dd>
        </div>
        <div>
          <dt class="mono">La salle</dt>
          <dd>1 200 m², 3 espaces</dd>
        </div>
        <div>
          <dt class="mono">Depuis {SITE.ville}</dt>
          <dd>
            <a class="hero__fait-lien" href={route('transports').chemin}>
              {SITE.accesCourt}<span class="fleche" aria-hidden="true">→</span>
            </a>
          </dd>
        </div>
      </dl>
    </div>
  </div>

  {/* ─────────────── LE PLAN ─────────────── */}
  <div class="enveloppe">
    <figure class="plan" data-plan>
      <figcaption class="vh">
        Plan de la salle Boxing Center Toulouse États-Unis, 388 avenue des
        États-Unis : trois espaces de 400 m². Le premier réunit le striking et le
        travail au sol, avec une cage surélevée officielle et des tatamis. Le
        deuxième est l’espace boxe, avec deux rings de compétition. Le troisième
        est l’espace préparation physique, avec seize sacs de frappe, de la
        musculation, du cardio et une cage de cross-training.
      </figcaption>

      {/* ── Tracé horizontal — écrans larges ── */}
      <svg
        class="plan__svg plan__svg--h"
        viewBox="0 0 1200 460"
        role="img"
        aria-hidden="true"
        preserveAspectRatio="xMidYMid meet"
      >
        {/* Espace 1 — striking et travail au sol */}
        <g class="plan__espace" style="--rang:1">
          <rect class="plan__mur" x="60" y="60" width="340" height="280" />
          <polygon
            class="plan__cage"
            points="230,120 288,150 288,220 230,250 172,220 172,150"
          />
          <text class="plan__espace-nom" x="230" y="300" text-anchor="middle">STRIKING &amp; SOL</text>
          <text class="plan__espace-aire" x="230" y="322" text-anchor="middle">400 m² de tatamis</text>
        </g>

        {/* Espace 2 — la boxe, deux rings */}
        <g class="plan__espace" style="--rang:2">
          <rect class="plan__mur" x="420" y="60" width="340" height="280" />
          <rect class="plan__ring" x="452" y="112" width="132" height="112" />
          <rect class="plan__ring" x="600" y="112" width="132" height="112" />
          <text class="plan__espace-nom" x="590" y="300" text-anchor="middle">BOXE</text>
          <text class="plan__espace-aire" x="590" y="322" text-anchor="middle">2 rings de compétition</text>
        </g>

        {/* Espace 3 — préparation physique, seize sacs */}
        <g class="plan__espace" style="--rang:3">
          <rect class="plan__mur" x="780" y="60" width="340" height="280" />
          {sacs.map((i) => (
            <circle
              class="plan__sac"
              cx={812 + (i % 8) * 40}
              cy={i < 8 ? 130 : 186}
              r="9"
              style={`--n:${i}`}
            />
          ))}
          <rect class="plan__rack" x="812" y="228" width="276" height="30" />
          <text class="plan__espace-nom" x="950" y="300" text-anchor="middle">PRÉPARATION PHYSIQUE</text>
          <text class="plan__espace-aire" x="950" y="322" text-anchor="middle">16 sacs de frappe</text>
        </g>

        {/* L'avenue, l'entrée, et l'arrêt de bus */}
        <path class="plan__avenue" d="M 40 400 H 1160" />
        <path class="plan__entree" d="M 590 340 V 400" />
        <g class="plan__adresse">
          <circle class="plan__point" cx="590" cy="400" r="8" />
          <text class="plan__adresse-num" x="590" y="432" text-anchor="middle">388</text>
        </g>
        <text class="plan__avenue-nom" x="60" y="392" text-anchor="start">AVENUE DES ÉTATS-UNIS</text>
        <g class="plan__arret">
          <rect x="880" y="392" width="16" height="16" />
          <text class="plan__arret-nom" x="906" y="405" text-anchor="start">ARRÊT 59</text>
        </g>
      </svg>

      {/* ── Tracé vertical — téléphones ── */}
      <svg
        class="plan__svg plan__svg--v"
        viewBox="0 0 360 660"
        role="img"
        aria-hidden="true"
        preserveAspectRatio="xMidYMid meet"
      >
        <g class="plan__espace" style="--rang:1">
          <rect class="plan__mur" x="76" y="30" width="250" height="160" />
          <polygon class="plan__cage" points="152,62 196,84 196,128 152,150 108,128 108,84" />
          <text class="plan__espace-nom" x="216" y="176" text-anchor="middle">STRIKING &amp; SOL</text>
        </g>
        <g class="plan__espace" style="--rang:2">
          <rect class="plan__mur" x="76" y="210" width="250" height="160" />
          <rect class="plan__ring" x="100" y="238" width="90" height="76" />
          <rect class="plan__ring" x="206" y="238" width="90" height="76" />
          <text class="plan__espace-nom" x="222" y="356" text-anchor="middle">BOXE · 2 RINGS</text>
        </g>
        <g class="plan__espace" style="--rang:3">
          <rect class="plan__mur" x="76" y="390" width="250" height="160" />
          {sacs.map((i) => (
            <circle
              class="plan__sac"
              cx={100 + (i % 8) * 28}
              cy={i < 8 ? 424 : 462}
              r="7"
              style={`--n:${i}`}
            />
          ))}
          <rect class="plan__rack" x="100" y="490" width="200" height="22" />
          <text class="plan__espace-nom" x="236" y="536" text-anchor="middle">PRÉPA · 16 SACS</text>
        </g>

        <path class="plan__avenue" d="M 26 590 H 340" />
        <path class="plan__entree" d="M 180 550 V 590" />
        <g class="plan__adresse">
          <circle class="plan__point" cx="180" cy="590" r="8" />
          <text class="plan__adresse-num" x="180" y="622" text-anchor="middle">388</text>
        </g>
        <text class="plan__avenue-nom" x="26" y="582" text-anchor="start">AVENUE DES ÉTATS-UNIS</text>
      </svg>

      <div class="plan__bloc mono">
        <span><b>{SITE.ville}</b> → {DESTINATION.nomCourt}</span>
        <span>1 200 m² · 3 espaces</span>
        <span class="plan__bloc-src">{DESTINATION.adresse}</span>
      </div>
    </figure>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(2rem, 1rem + 4vw, 4.5rem) clamp(3rem, 2rem + 4vw, 5rem);
    background: var(--papier);
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(to right, var(--trait-faible) 1px, transparent 1px),
      linear-gradient(to bottom, var(--trait-faible) 1px, transparent 1px);
    background-size: 3.5rem 3.5rem;
    mask-image: radial-gradient(120% 90% at 45% 45%, #000 0%, transparent 78%);
    opacity: 0.55;
  }
  .hero > * { position: relative; }

  .hero__cartouche {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-3);
    align-items: center;
    padding-bottom: var(--e-4);
    border-bottom: 1px solid var(--trait);
    margin-bottom: var(--e-7);
  }
  .hero__planche { color: var(--signal-texte); font-weight: 700; }

  .hero__haut {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.65fr);
    gap: var(--e-6) var(--e-8);
    align-items: end;
  }
  @media (max-width: 62rem) {
    .hero__haut { grid-template-columns: 1fr; align-items: start; }
  }

  .hero__titre { max-width: 15ch; margin-bottom: var(--e-5); }
  .hero__ligne {
    display: block;
    animation: poser 760ms var(--e-sortie) both;
    animation-delay: calc(var(--i, 0) * 100ms);
  }
  .hero__ligne:nth-child(1) { --i: 0; }
  .hero__ligne:nth-child(2) { --i: 1; }
  .hero__ligne:nth-child(3) { --i: 2; }
  .hero__ligne--accent { color: var(--signal-texte); }
  @keyframes poser {
    from { opacity: 0; transform: translateX(0.5em); }
    to { opacity: 1; transform: none; }
  }

  .hero__promesse {
    max-width: 54ch;
    font-size: var(--t-lead);
    line-height: 1.45;
    color: var(--texte-faible);
    padding-left: var(--e-5);
    border-left: 2px solid var(--signal);
  }
  .hero__promesse strong { color: var(--encre); font-weight: 600; }

  .hero__actions { display: flex; flex-wrap: wrap; gap: var(--e-3); margin-top: var(--e-6); }

  .hero__faits { display: grid; gap: 0; margin: 0; }
  .hero__faits > div {
    display: grid;
    gap: 0.15rem;
    padding: var(--e-3) 0;
    border-top: 1px solid var(--trait);
  }
  .hero__faits > div:last-child { border-bottom: 1px solid var(--trait); }
  .hero__faits dt { color: var(--graphite); }
  .hero__faits dd { margin: 0; font-size: var(--t-petit); font-weight: 600; }
  .hero__fait-lien {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4em;
    color: var(--signal-texte);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color var(--d-rapide) var(--e-mecanique);
  }
  .hero__fait-lien:hover { border-color: currentColor; }

  /* ── Le plan ───────────────────────────────────────────────────────── */
  .plan { position: relative; margin: var(--e-8) 0 0; }
  .plan__svg { width: 100%; height: auto; overflow: visible; }
  .plan__svg--v { display: none; }
  @media (max-width: 48rem) {
    .plan__svg--h { display: none; }
    .plan__svg--v { display: block; max-width: 22rem; margin-inline: auto; }
  }

  /* Les trois espaces se posent l'un après l'autre, de gauche à droite. */
  .plan__espace {
    opacity: 0;
    animation: poser-espace 620ms var(--e-sortie) forwards;
    animation-delay: calc(200ms + var(--rang) * 200ms);
  }
  @keyframes poser-espace {
    from { opacity: 0; transform: translateY(0.9rem); }
    to { opacity: 1; transform: none; }
  }

  .plan__mur {
    fill: var(--signal-voile);
    stroke: var(--encre);
    stroke-width: 1.4;
    vector-effect: non-scaling-stroke;
  }
  .plan__cage {
    fill: none;
    stroke: var(--signal-texte);
    stroke-width: 2.5;
    vector-effect: non-scaling-stroke;
  }
  .plan__ring {
    fill: none;
    stroke: var(--signal-texte);
    stroke-width: 2.5;
    vector-effect: non-scaling-stroke;
  }
  .plan__rack {
    fill: none;
    stroke: var(--graphite);
    stroke-width: 1.4;
    vector-effect: non-scaling-stroke;
  }
  /* Les seize sacs se remplissent un par un : on compte avec le dessin. */
  .plan__sac {
    fill: var(--signal-texte);
    opacity: 0;
    animation: apparaitre 260ms var(--e-mecanique) forwards;
    animation-delay: calc(900ms + var(--n) * 55ms);
  }
  @keyframes apparaitre { to { opacity: 1; } }

  .plan__espace-nom {
    font-family: var(--police-mono);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.12em;
    fill: var(--encre);
  }
  .plan__espace-aire {
    font-family: var(--police-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    fill: var(--signal-texte);
  }

  .plan__avenue {
    stroke: var(--graphite);
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
    fill: none;
    opacity: 0.5;
  }
  .plan__entree {
    stroke: var(--signal-texte);
    stroke-width: 2;
    stroke-dasharray: 5 4;
    vector-effect: non-scaling-stroke;
    fill: none;
  }
  .plan__adresse {
    opacity: 0;
    animation: apparaitre 420ms var(--e-sortie) 1100ms forwards;
  }
  .plan__point {
    fill: var(--signal-texte);
    transform-box: fill-box;
    transform-origin: center;
    animation: battre 2.6s var(--e-mecanique) 2.2s infinite;
  }
  @keyframes battre {
    0%, 74%, 100% { transform: scale(1); opacity: 1; }
    86% { transform: scale(1.7); opacity: 0.35; }
  }
  .plan__adresse-num {
    font-family: var(--police-mono);
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.1em;
    fill: var(--encre);
  }
  .plan__avenue-nom,
  .plan__arret-nom {
    font-family: var(--police-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    fill: var(--graphite);
  }
  .plan__arret rect {
    fill: var(--papier-vif);
    stroke: var(--encre);
    stroke-width: 1.2;
    vector-effect: non-scaling-stroke;
  }

  .plan__bloc {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-2) var(--e-5);
    margin-top: var(--e-5);
    padding-top: var(--e-3);
    border-top: 1px solid var(--trait);
    text-transform: none;
    letter-spacing: 0.05em;
    color: var(--graphite);
  }
  .plan__bloc b { color: var(--encre); font-weight: 700; }
  .plan__bloc-src { margin-left: auto; }
  @media (max-width: 62rem) { .plan__bloc-src { margin-left: 0; } }

  /* ── Sans script, et en mouvement réduit : le plan est déjà fini. ──── */
  :global(.no-js) .plan__espace,
  :global(.no-js) .plan__sac,
  :global(.no-js) .plan__adresse,
  :global(.no-js) .hero__ligne { animation: none; opacity: 1; transform: none; }

  @media (prefers-reduced-motion: reduce) {
    .plan__espace,
    .plan__sac,
    .plan__adresse,
    .plan__point,
    .hero__ligne { animation: none !important; opacity: 1; transform: none; }
  }
</style>
